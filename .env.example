# Скопируйте в .env и заполните реальными значениями.
# На Render эти переменные задаются в Dashboard → Environment,
# сам .env файл на Render не нужен и не должен туда попадать.

# Токен Telegram-бота от @BotFather
TELEGRAM_TOKEN=

# ID чата/канала, куда бот шлёт уведомления о заказах
TELEGRAM_CHAT_ID=

# Пароль для входа в админку (задайте длинный случайный пароль)
ADMIN_PASSWORD=

# Путь до админки вместо стандартного /admin (без слэшей).
# Придумайте что-то непредсказуемое, например: shefpanel-9k2x
# Если не задать — будет использоваться /admin.
ADMIN_PATH=

# Фото товаров грузятся в Cloudinary (бесплатный тариф), а не на диск —
# на free-плане Render диска нет, и всё, что лежит рядом с кодом, стирается
# при каждом деплое. Зарегистрируйтесь на cloudinary.com и возьмите
# значение в Dashboard -> Account Details -> "API Environment variable".
# Формат: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
